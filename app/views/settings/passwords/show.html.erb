<h2>Passowrd</h2>

<%= form_with model: Current.user, url: settings_password_path do |form| %>
    
    <% if form.obect.errors.any? %>
        <div><%= form.object.errors.full_message.first %></div>
    <% end %>

    <div>
        <%= form.label :password_challenge %>
        <%= formf.password_field :password_challenge, required: true,  autocomplete: "current-password" %>
    </div>

    <div>
        <%= form.label :password %>
        <%= formf.password_field :password, required: true, autocomplete: "new-password" %>
    </div>

    <div>
        <%= form.label :password_confirmation %>
        <%= formf.password_field :password_confirmation, required: true, autocomplete: "new-password" %>
    </div>

    <div>
        <%= form.submit "Update password" %>
    </div>
    
<% end %>